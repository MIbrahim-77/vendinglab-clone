# NEXT_PUBLIC_SITE_URL — used for canonical URLs and OG tags
# Development: http://localhost:3000
# Production:  https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# NEXT_PUBLIC_GRAPHQL_URL — WordPress WPGraphQL endpoint
NEXT_PUBLIC_GRAPHQL_URL=https://vendinglab.tech/graphql

# NEXT_PUBLIC_PAYLOAD_URL — Payload CMS backend URL
# Development: http://localhost:3001
# Production:  https://your-backend-url.com
NEXT_PUBLIC_PAYLOAD_URL=https://your-backend-url.com

# Instagram Basic Display API token (leave empty to use mock data)
NEXT_PUBLIC_INSTAGRAM_TOKEN=your-instagram-token-here
